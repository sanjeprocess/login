# true = run with the built-in mock API (no backend needed)
# false = call the real webform backend at VITE_API_BASE_URL
VITE_USE_MOCK_API=true
VITE_API_BASE_URL=/api

# Shown in the footer and on error pages
VITE_BROKER_NAME=Aitken Spence Insurance Brokers
VITE_SUPPORT_PHONE=[Support phone]
VITE_SUPPORT_EMAIL=[Support email]

# Premium payment step after binding (not part of the pilot)
VITE_PAYMENT_ENABLED=false
